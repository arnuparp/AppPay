@model Apppay.Models.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="auth-icon"><i class="bi bi-wallet2"></i></div>
            <h3 class="text-center fw-bold mb-1">ยินดีต้อนรับ</h3>
            <p class="text-center text-muted mb-4">เข้าสู่ระบบเพื่อจัดการรายรับ-รายจ่ายของคุณ</p>
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2"><i class="bi bi-box-arrow-in-right me-1"></i>เข้าสู่ระบบ</button>
            </form>
            <p class="text-center mt-4 mb-0 text-muted">
                ยังไม่มีบัญชี? <a asp-controller="Account" asp-action="Register" class="fw-semibold text-decoration-none">สมัครสมาชิก</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
