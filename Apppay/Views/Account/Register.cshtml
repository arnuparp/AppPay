@model Apppay.Models.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="auth-icon"><i class="bi bi-person-plus"></i></div>
            <h3 class="text-center fw-bold mb-1">สร้างบัญชีใหม่</h3>
            <p class="text-center text-muted mb-4">เริ่มบันทึกรายรับ-รายจ่ายของคุณวันนี้</p>
            <form asp-controller="Account" asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-person"></i></span>
                        <input asp-for="DisplayName" class="form-control" />
                    </div>
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2"><i class="bi bi-check-circle me-1"></i>สมัครสมาชิก</button>
            </form>
            <p class="text-center mt-4 mb-0 text-muted">
                มีบัญชีอยู่แล้ว? <a asp-controller="Account" asp-action="Login" class="fw-semibold text-decoration-none">เข้าสู่ระบบ</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
