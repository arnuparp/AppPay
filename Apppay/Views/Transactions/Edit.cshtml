@model Apppay.Models.Transaction
@{
    ViewData["Title"] = "แก้ไขรายการ";
    var categories = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories;
}

<h3 class="page-heading mb-4"><i class="bi bi-pencil-square me-1"></i>แก้ไขรายการรายรับ-รายจ่าย</h3>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">สลิปโอนเงิน</label>
                        @if (Model.Slips.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var slip in Model.Slips.OrderByDescending(s => s.UploadedAt))
                                {
                                    <div class="position-relative">
                                        <a asp-action="ViewSlip" asp-route-id="@slip.Id" target="_blank">
                                            <img src="@Url.Action("ViewSlip", new { id = slip.Id })" style="width:64px;height:64px;object-fit:cover;border-radius:8px;border:1px solid #dee2e6;" />
                                        </a>
                                        <form asp-action="DeleteSlip" method="post" class="position-absolute top-0 end-0" onsubmit="return confirm('ลบรูปสลิปนี้?');">
                                            <input type="hidden" name="id" value="@slip.Id" />
                                            <input type="hidden" name="transactionId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-circle p-0" style="width:20px;height:20px;line-height:1;transform:translate(30%,-30%);"><i class="bi bi-x" style="font-size:12px;"></i></button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        <input type="file" name="slipFiles" id="slipFiles" class="form-control" accept="image/png,image/jpeg,image/webp" multiple />
                        <div class="form-text">แนบเพิ่มได้หลายรูป ระบบจะอ่านจำนวนเงินจากทุกรูปที่แนบใหม่แล้วรวมยอดให้อัตโนมัติ กดปุ่ม × ที่มุมรูปเพื่อยกเลิกรูปที่ไม่ต้องการได้</div>
                        <div id="scanStatus" class="form-text text-primary"></div>
                        <div id="slipPreview" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-currency-exchange"></i></span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note" class="form-control" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>บันทึก</button>
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">ยกเลิก</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/slip-upload.js"></script>
}
