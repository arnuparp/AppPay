@model List<Apppay.Models.Category>
@{
    ViewData["Title"] = "จัดการหมวดหมู่";
    var incomeCats = Model.Where(c => c.Type == Apppay.Models.TransactionType.Income).ToList();
    var expenseCats = Model.Where(c => c.Type == Apppay.Models.TransactionType.Expense).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="page-heading mb-0"><i class="bi bi-tags me-1"></i>จัดการหมวดหมู่</h3>
        <div class="subtitle">ข้อมูลหลัก (Master Data) สำหรับใช้จัดหมวดรายการของคุณ</div>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i>เพิ่มหมวดหมู่</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <h6 class="fw-semibold mb-3" style="color:var(--income)"><i class="bi bi-arrow-down-circle-fill me-1"></i>รายรับ</h6>
        <div class="table-card mb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                        @if (!incomeCats.Any())
                        {
                            <tr><td><div class="empty-state py-4"><div class="empty-icon"><i class="bi bi-tag"></i></div>ยังไม่มีหมวดหมู่รายรับ</div></td></tr>
                        }
                        @foreach (var c in incomeCats)
                        {
                            <tr>
                                <td>
                                    <span class="cat-chip" style="background-color:@(c.Color)22; color:@c.Color">
                                        <span class="cat-dot" style="background-color:@c.Color"></span>@c.Name
                                    </span>
                                </td>
                                <td class="text-end" style="width:110px">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash3"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <h6 class="fw-semibold mb-3" style="color:var(--expense)"><i class="bi bi-arrow-up-circle-fill me-1"></i>รายจ่าย</h6>
        <div class="table-card mb-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                        @if (!expenseCats.Any())
                        {
                            <tr><td><div class="empty-state py-4"><div class="empty-icon"><i class="bi bi-tag"></i></div>ยังไม่มีหมวดหมู่รายจ่าย</div></td></tr>
                        }
                        @foreach (var c in expenseCats)
                        {
                            <tr>
                                <td>
                                    <span class="cat-chip" style="background-color:@(c.Color)22; color:@c.Color">
                                        <span class="cat-dot" style="background-color:@c.Color"></span>@c.Name
                                    </span>
                                </td>
                                <td class="text-end" style="width:110px">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash3"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
